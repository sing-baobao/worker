---
// src/components/DashboardPanel.astro
import PongGame from './PongGame.astro';
---

<div class="backend-tester">
  <!-- Status Box is housed here inside the Dashboard -->
  <div class="user-status">
    <div class="status-info">
      <span class="status-dot"></span> 
      <span class="status-text">Connected as: <strong id="userEmailDisplay"></strong> <span id="authMethodDisplay" class="auth-badge"></span></span>
    </div>
    <button id="dashboardLogoutBtn" class="logout-btn" type="button">Logout</button>
  </div>

  <div class="box">
    <h3>Welcome to your Dashboard</h3>
    <p class="subtitle">You have successfully authenticated and your session is active.</p>
  </div>

  <!-- Interactive Edge Pong Component -->
  <PongGame />

</div>

<style>
  .backend-tester {
    box-sizing: border-box;
    margin-top: 20px;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    max-width: 800px;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    padding: 10px;
  }

  .backend-tester *, .backend-tester *::before, .backend-tester *::after {
    box-sizing: border-box;
  }

  .box {
    margin-bottom: 20px;
    padding: 15px;
    border: 1px solid #ccc;
    border-radius: 6px;
    background: #fff;
  }

  .subtitle {
    font-size: 0.9rem;
    color: #666;
    margin-top: 0;
    margin-bottom: 10px;
  }

  /* User Status Banner styles - mobile friendly flex-wrap */
  .user-status {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    background: #e6f4ea;
    border: 1px solid #ceead6;
    color: #137333;
    padding: 12px 15px;
    border-radius: 6px;
    margin-bottom: 20px;
    font-size: 0.95rem;
    word-break: break-all;
  }

  .status-info {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    flex: 1;
    min-width: 0;
  }

  .status-dot {
    height: 8px;
    width: 8px;
    background-color: #34a853;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }

  .status-text {
    overflow-wrap: anywhere;
  }

  .auth-badge {
    display: inline-block;
    background: #d4edda;
    border: 1px solid #c3e6cb;
    color: #155724;
    padding: 1px 6px;
    font-size: 0.8rem;
    border-radius: 4px;
    text-transform: capitalize;
    font-weight: 600;
  }

  .logout-btn {
    background: #c5221f;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 14px;
    font-size: 0.85rem;
    cursor: pointer;
    font-weight: 500;
    flex-shrink: 0;
    min-height: 36px;
  }

  .logout-btn:hover {
    background: #a51d1a;
  }

  #output {
    background: #f4f4f4;
    padding: 12px;
    min-height: 80px;
    border-radius: 4px;
    white-space: pre-wrap;
    word-break: break-all;
    color: #333;
  }
</style>

<script>
  import { API_URL } from '../config.js';

  function parseJwt(token) {
    try {
      if (!token || typeof token !== 'string' || token === 'undefined' || token === 'null') {
        return null;
      }
      const parts = token.split('.');
      if (parts.length !== 3) return null;

      const base64Url = parts[1];
      const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
      const jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {
        return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
      }).join(''));
      return JSON.parse(jsonPayload);
    } catch (e) {
      console.error("Failed to parse JWT:", e);
      return null;
    }
  }

  function initDashboard() {
    // 1. Capture token if it's sitting in the URL query params (OAuth redirect)
    const urlParams = new URLSearchParams(window.location.search);
    const tokenParam = urlParams.get("token");

    if (tokenParam) {
      localStorage.setItem("jwt", tokenParam);
      // Clean up the URL bar immediately
      window.history.replaceState({}, document.title, window.location.pathname);
    }

    // 2. Retrieve token from localStorage
    const token = localStorage.getItem("jwt");
    
    if (token) {
      const decoded = parseJwt(token);
      if (decoded) {
        const email = decoded.sub || decoded.email || "User";
        const provider = decoded.provider || "unknown";

        const emailEl = document.getElementById("userEmailDisplay");
        const providerEl = document.getElementById("authMethodDisplay");

        if (emailEl) emailEl.textContent = email;
        if (providerEl) providerEl.textContent = `via ${provider}`;
      } else {
        localStorage.removeItem("jwt");
      }
    }
  }

  // Run on load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDashboard);
  } else {
    initDashboard();
  }

  // Handle Logout button click inside dashboard
  document.getElementById("dashboardLogoutBtn")?.addEventListener("click", () => {
    localStorage.removeItem("jwt");
    window.location.href = "/";
  });
</script>