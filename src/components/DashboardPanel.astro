---
// src/components/DashboardPanel.astro
import PongGame from './PongGame.astro';
---

<div class="backend-tester">
  <!-- Status Box is now housed here inside the Dashboard -->
  <div class="user-status">
    <span class="status-dot"></span> 
    <span>Connected as: <strong id="userEmailDisplay"></strong> <span id="authMethodDisplay" class="auth-badge"></span></span>
    <button id="dashboardLogoutBtn" class="logout-btn" type="button">Logout</button>
  </div>

  <div class="box">
    <h3>Welcome to your Dashboard</h3>
    <p class="subtitle">You have successfully authenticated and your session is active.</p>
  </div>

  <!--
  <div class="box">
    <h3>Protected Actions</h3>
    <p class="subtitle">Test token-protected endpoints:</p>
    <button id="fetchProtectedBtn">Call Protected API</button>
  </div>

  <div>
    <h3>API Response:</h3>
    <pre id="output"></pre>
  </div>
  -->

  <!-- Interactive Edge Pong Component -->
  <PongGame />

</div>

<style>
  .backend-tester {
    margin-top: 20px;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
    padding: 20px;
  }
  .box {
    margin-bottom: 20px;
    padding: 15px;
    border: 1px solid #ccc;
    border-radius: 4px;
  }
  .subtitle {
    font-size: 0.9rem;
    color: #666;
    margin-top: 0;
    margin-bottom: 10px;
  }
  button {
    padding: 6px 12px;
    cursor: pointer;
    background: #1a73e8;
    color: white;
    border: none;
    border-radius: 4px;
  }
  button:hover {
    background: #1557b0;
  }
  /* User Status Banner styles */
  .user-status {
    display: flex;
    align-items: center;
    background: #e6f4ea;
    border: 1px solid #ceead6;
    color: #137333;
    padding: 10px 15px;
    border-radius: 4px;
    margin-bottom: 20px;
    font-size: 0.95rem;
  }
  .status-dot {
    height: 8px;
    width: 8px;
    background-color: #34a853;
    border-radius: 50%;
    display: inline-block;
    margin-right: 8px;
  }
  .auth-badge {
    display: inline-block;
    background: #d4edda;
    border: 1px solid #c3e6cb;
    color: #155724;
    padding: 1px 6px;
    font-size: 0.8rem;
    border-radius: 4px;
    margin-left: 6px;
    text-transform: capitalize;
    font-weight: 600;
  }
  .logout-btn {
    margin-left: auto;
    background: #c5221f;
    color: white;
    border: none;
    border-radius: 3px;
    padding: 4px 10px;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .logout-btn:hover {
    background: #a51d1a;
  }
  #output {
    background: #f4f4f4;
    padding: 12px;
    min-height: 80px;
    border-radius: 4px;
    white-space: pre-wrap;
    word-break: break-all;
    color: #333;
  }
</style>

<script>
  import { API_URL } from '../config.js';

  function parseJwt(token) {
    try {
      if (!token || typeof token !== 'string' || token === 'undefined' || token === 'null') {
        return null;
      }
      const parts = token.split('.');
      if (parts.length !== 3) return null;

      const base64Url = parts[1];
      const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
      const jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {
        return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
      }).join(''));
      return JSON.parse(jsonPayload);
    } catch (e) {
      console.error("Failed to parse JWT:", e);
      return null;
    }
  }

  function initDashboard() {
    // 1. Capture token if it's sitting in the URL query params (GitHub OAuth redirect)
    const urlParams = new URLSearchParams(window.location.search);
    const tokenParam = urlParams.get("token");

    if (tokenParam) {
      localStorage.setItem("jwt", tokenParam);
      // Clean up the URL bar immediately
      window.history.replaceState({}, document.title, window.location.pathname);
    }

    // 2. Retrieve token from localStorage
    const token = localStorage.getItem("jwt");
    
    if (token) {
      const decoded = parseJwt(token);
      if (decoded) {
        const email = decoded.sub || decoded.email || "User";
        const provider = decoded.provider || "unknown";

        const emailEl = document.getElementById("userEmailDisplay");
        const providerEl = document.getElementById("authMethodDisplay");

        if (emailEl) emailEl.textContent = email;
        if (providerEl) providerEl.textContent = `via ${provider}`;
      } else {
        // Clear out invalid token automatically
        localStorage.removeItem("jwt");
      }
    }
  }

  // Run on load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDashboard);
  } else {
    initDashboard();
  }

  // Handle Logout button inside dashboard
  document.getElementById("dashboardLogoutBtn")?.addEventListener("click", () => {
    localStorage.removeItem("jwt");
    window.location.href = "/";
  });

  // Handle Protected API Test Call
  document.getElementById("fetchProtectedBtn")?.addEventListener("click", async () => {
    const output = document.getElementById("output");
    const jwtToken = localStorage.getItem("jwt") || "";
    if (output) output.textContent = "Calling protected endpoint...";

    try {
      const res = await fetch(`${API_URL}/api/protected`, {
        method: "GET",
        headers: {
          "Authorization": `Bearer ${jwtToken}`
        }
      });
      const data = await res.json();
      if (output) {
        output.textContent = `Status: ${res.status}\nResponse: ${JSON.stringify(data, null, 2)}`;
      }
    } catch (err) {
      if (output) output.textContent = `Request Error: ${err.message}`;
    }
  });
</script>

<script>
  const logoutBtn = document.getElementById('dashboardLogoutBtn');
  logoutBtn?.addEventListener('click', () => {
    localStorage.removeItem('jwt');
    window.location.href = '/';
  });
</script>

<style>
  .dashboard-wrapper {
    color: #f8fafc;
  }
  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }
  .logout-btn {
    background: #ef4444;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
  }
  .logout-btn:hover { background: #dc2626; }
</style>