---
// src/components/RegisterForm.astro
---

<form id="register-form">
  <div style="margin-bottom: 1rem;">
    <label for="email" style="display: block; margin-bottom: 0.5rem;">Email Address</label>
    <input type="email" id="email" name="email" required style="padding: 0.5rem; width: 100%; max-width: 300px;" />
  </div>
  
  <div style="margin-bottom: 1rem;">
    <label for="password" style="display: block; margin-bottom: 0.5rem;">Password</label>
    <input type="password" id="password" name="password" required style="padding: 0.5rem; width: 100%; max-width: 300px;" />
  </div>

  <!-- Cloudflare Turnstile Widget -->
  <div style="margin-bottom: 1rem;">
    <div class="cf-turnstile" data-sitekey="0x4AAAAAAF64B-MBnghwkz8u"></div>
  </div>

  <button type="submit" style="padding: 0.5rem 1rem; cursor: pointer;">Register</button>
  
  <p id="reg-status" style="margin-top: 1rem; display: none; padding: 8px 12px; border-radius: 4px;"></p>
</form>

<!-- Load Cloudflare Turnstile JavaScript API -->
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  import { API_URL } from '../config.js';

  const form = document.getElementById('register-form');
  const statusMsg = document.getElementById('reg-status');

  // Pre-fill email from query parameters if passed from login page
  const urlParams = new URLSearchParams(window.location.search);
  const passedEmail = urlParams.get("email");
  if (passedEmail) {
    const emailInput = document.getElementById("email") as HTMLInputElement;
    if (emailInput) emailInput.value = passedEmail;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!statusMsg) return;

    statusMsg.style.display = 'none';

    const formData = new FormData(e.currentTarget as HTMLFormElement);
    const email = formData.get('email');
    const password = formData.get('password');

    // Extract the Turnstile token generated by the widget upon completion
    const cfToken = formData.get('cf-turnstile-response');

    if (!cfToken) {
      statusMsg.style.color = '#990000';
      statusMsg.style.background = '#fdecea';
      statusMsg.style.border = '1px solid #f5c6cb';
      statusMsg.textContent = 'Please complete the security challenge verification.';
      statusMsg.style.display = 'block';
      return;
    }

    try {
      const res = await fetch(`${API_URL}/api/auth/register`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password, cfToken }),
      });

      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        throw new Error(data.error || `Server returned error ${res.status}`);
      }

      statusMsg.style.color = '#137333';
      statusMsg.style.background = '#e6f4ea';
      statusMsg.style.border = '1px solid #ceead6';
      statusMsg.textContent = 'Account created successfully! Check your email and click the verification link. Redirecting to login...';
      statusMsg.style.display = 'block';

      setTimeout(() => {
        window.location.href = '/';
      }, 1500);
    } catch (err: any) {
      statusMsg.style.color = '#990000';
      statusMsg.style.background = '#fdecea';
      statusMsg.style.border = '1px solid #f5c6cb';
      
      let message = err.message || "";
      
      // Check if the error indicates a duplicate email / social provider conflict
      if (message.includes("UNIQUE constraint failed") || message.includes("already exists")) {
        statusMsg.innerHTML = `This email is already registered. Please <a href="/" style="color: #1a0dab; text-decoration: underline; font-weight: 500;">log in here</a> instead.`;
      } else if (message.toLowerCase().includes("oauth") || message.toLowerCase().includes("github")) {
        statusMsg.innerHTML = `This email is associated with a social login provider. Please use social login on the home page.`;
      } else {
        statusMsg.textContent = message;
      } 
      
      statusMsg.style.display = 'block';
    }
  });
</script>