---
// src/components/BackendTester.astro
---

<div class="backend-tester">
  <div class="box">
    <h3>1. Login (Obtain JWT)</h3>
    <input type="text" id="username" placeholder="Enter username" value="" />
    <input type="password" id="password" placeholder="Enter password" value="" />
    <button id="loginBtn">Login</button>
  </div>

  <div class="box">
    <h3>2. Test Protected Route</h3>
    <button id="fetchBtn" disabled>Call Protected API</button>
  </div>

  <div>
    <h3>Live Status / Response:</h3>
    <pre id="output"></pre>
  </div>
</div>

<style>
  .backend-tester {
    margin-top: 20px;
  }
  .box {
    margin-bottom: 20px;
    padding: 15px;
    border: 1px solid #ccc;
    border-radius: 4px;
  }
  input {
    margin-right: 8px;
    padding: 6px 10px;
  }
  button {
    padding: 6px 12px;
    cursor: pointer;
  }
  #output {
    background: #f4f4f4;
    padding: 12px;
    min-height: 80px;
    border-radius: 4px;
    white-space: pre-wrap;
    word-break: break-all;
  }
</style>

<script>
  const WORKER_URL = "https://worker.singbaobao.com";
  const output = document.getElementById("output");
  const fetchBtn = document.getElementById("fetchBtn");
  let jwtToken = localStorage.getItem("jwt") || "";

  const updateUIState = () => {
    if (jwtToken && fetchBtn) {
      fetchBtn.removeAttribute("disabled");
      if (output) {
        output.textContent = "Token loaded from localStorage. Ready to query protected endpoint.";
      }
    }
  };
  updateUIState();

  // Handle Login
  document.getElementById("loginBtn")?.addEventListener("click", async () => {
    const username = (document.getElementById("username") as HTMLInputElement)?.value;
    const password = (document.getElementById("password") as HTMLInputElement)?.value;

    if (output) output.textContent = "Authenticating...";

    try {
      const res = await fetch(`${WORKER_URL}/api/login`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ username, password })
      });
      const data = await res.json();

      if (res.ok) {
        jwtToken = data.token;
        localStorage.setItem("jwt", jwtToken);
        if (output) output.textContent = `Success! JWT Acquired:\n${jwtToken}`;
        updateUIState();
      } else {
        if (output) output.textContent = `Login Failed: ${JSON.stringify(data)}`;
      }
    } catch (err: any) {
      if (output) output.textContent = `Network/CORS Error: ${err.message}`;
    }
  });

  // Handle Protected API Request
  document.getElementById("fetchBtn")?.addEventListener("click", async () => {
    if (output) output.textContent = "Sending request with Bearer token...";

    try {
      const res = await fetch(`${WORKER_URL}/api/protected`, {
        method: "GET",
        headers: {
          "Authorization": `Bearer ${jwtToken}`
        }
      });
      const data = await res.json();
      if (output) {
        output.textContent = `Status: ${res.status}\nResponse: ${JSON.stringify(data, null, 2)}`;
      }
    } catch (err: any) {
      if (output) output.textContent = `CORS or Request Error: ${err.message}`;
    }
  });
</script>