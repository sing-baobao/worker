---
// src/components/ResetPasswordForm.astro
---

<form id="reset-form">
  <h3>Set New Password</h3>
  <p class="subtitle">Enter your new password below.</p>

  <div style="margin-bottom: 1rem;">
    <label for="newPassword" style="display: block; margin-bottom: 0.5rem;">New Password</label>
    <div class="password-wrapper">
      <input type="password" id="newPassword" name="newPassword" required style="padding: 0.5rem; padding-right: 2.5rem; width: 100%; box-sizing: border-box;" />
      <button type="button" id="togglePasswordBtn" class="toggle-btn" aria-label="Toggle password visibility">
        👁️
      </button>
    </div>
  </div>

  <button type="submit" style="padding: 0.5rem 1rem; cursor: pointer;">Update Password</button>
  
  <p id="reset-status" style="margin-top: 1rem; display: none; padding: 8px 12px; border-radius: 4px;"></p>
</form>

<style>
  .subtitle {
    font-size: 0.95rem;
    color: #666;
    margin-top: 0;
    margin-bottom: 12px;
  }

  .password-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 300px;
    width: 100%;
  }

  .toggle-btn {
    position: absolute;
    right: 6px;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666;
    user-select: none;
  }

  .toggle-btn:focus {
    outline: none;
  }
</style>

<script>
  import { API_URL } from '../config.js';

  const form = document.getElementById('reset-form');
  const statusMsg = document.getElementById('reset-status');
  const passwordInput = document.getElementById('newPassword') as HTMLInputElement;
  const toggleBtn = document.getElementById('togglePasswordBtn');

  // Handle Show/Hide Password Toggle
  toggleBtn?.addEventListener('click', () => {
    if (!passwordInput) return;
    if (passwordInput.type === 'password') {
      passwordInput.type = 'text';
      toggleBtn.textContent = '🔒';
    } else {
      passwordInput.type = 'password';
      toggleBtn.textContent = '👁️';
    }
  });

  // Grab token and email from the URL
  const urlParams = new URLSearchParams(window.location.search);
  const token = urlParams.get('token');
  const email = urlParams.get('email');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!statusMsg) return;

    statusMsg.style.display = 'none';

    if (!token || !email) {
      statusMsg.style.color = '#990000';
      statusMsg.style.background = '#fdecea';
      statusMsg.style.border = '1px solid #f5c6cb';
      statusMsg.textContent = 'Invalid or missing reset link parameters.';
      statusMsg.style.display = 'block';
      return;
    }

    const formData = new FormData(e.currentTarget as HTMLFormElement);
    const newPassword = formData.get('newPassword');

    try {
      const res = await fetch(`${API_URL}/api/auth/reset-password`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, token, newPassword }),
      });

      const data = await res.json().catch(() => ({}));

      if (!res.ok) {
        throw new Error(data.error || `Server returned error ${res.status}`);
      }

      statusMsg.style.color = '#137333';
      statusMsg.style.background = '#e6f4ea';
      statusMsg.style.border = '1px solid #ceead6';
      statusMsg.textContent = 'Password updated successfully! Redirecting to login...';
      statusMsg.style.display = 'block';

      setTimeout(() => {
        window.location.href = '/';
      }, 2000);
    } catch (err: any) {
      statusMsg.style.color = '#990000';
      statusMsg.style.background = '#fdecea';
      statusMsg.style.border = '1px solid #f5c6cb';
      statusMsg.textContent = err.message || 'An error occurred.';
      statusMsg.style.display = 'block';
    }
  });
</script>