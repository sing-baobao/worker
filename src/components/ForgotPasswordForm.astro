---
// src/components/ForgotPasswordForm.astro
---
<form id="forgot-form">
  <h3>Reset Password</h3>
  <p class="subtitle">Enter your email address and we'll send you a link to reset your password.</p>
  <div style="margin-bottom: 1rem;">
    <label for="forgotEmail" style="display: block; margin-bottom: 0.5rem;">Email Address</label>
    <input type="email" id="forgotEmail" name="email" required style="padding: 0.5rem; width: 100%; max-width: 300px;" />
  </div>
  <button type="submit" style="padding: 0.5rem 1rem; cursor: pointer;">Send Reset Link</button>
  <div style="margin-top: 1rem;">
    <a href="#" id="backToLoginLink" style="color: #1a0dab; text-decoration: underline; font-size: 0.9rem;">Back to Login</a>
  </div>
  <p id="forgot-status" style="margin-top: 1rem; display: none; padding: 8px 12px; border-radius: 4px;"></p>
</form>
<script>
  import { API_URL } from '../config.js';
  const form = document.getElementById('forgot-form');
  const statusMsg = document.getElementById('forgot-status');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!statusMsg) return;
    statusMsg.style.display = 'none';
    const formData = new FormData(e.currentTarget as HTMLFormElement);
    const email = formData.get('email');
    try {
      const res = await fetch(`${API_URL}/api/auth/forgot-password`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error(data.error || `Server returned error ${res.status}`);
      }
      statusMsg.style.color = '#137333';
      statusMsg.style.background = '#e6f4ea';
      statusMsg.style.border = '1px solid #ceead6';
      statusMsg.textContent = data.message || 'If that email exists, a reset link has been sent.';
      statusMsg.style.display = 'block';
    } catch (err: any) {
      statusMsg.style.color = '#990000';
      statusMsg.style.background = '#fdecea';
      statusMsg.style.border = '1px solid #f5c6cb';
      statusMsg.textContent = err.message || 'An error occurred. Please try again.';
      statusMsg.style.display = 'block';
    }
  });
  document.getElementById('backToLoginLink')?.addEventListener('click', (e) => {
    e.preventDefault();
    const forgotSec = document.getElementById('forgotPasswordSection');
    const loginSec = document.getElementById('loginSection');
    if (forgotSec) forgotSec.style.display = 'none';
    if (loginSec) loginSec.style.display = 'block';
  });
</script> 