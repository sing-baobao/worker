---
// src/layouts/Layout.astro
interface Props {
  title?: string;
}

const { title = "Cloudflare Worker + JWT + CORS Test" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <main class="main-wrapper">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  body {
    font-family: system-ui, -apple-system, sans-serif;
    margin: 0;
    padding: 0;
    background-color: #f9f9f9;
    color: #333;
    min-height: 100vh;
  }

  .main-wrapper {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    padding: 12px;
  }

  @media (min-width: 600px) {
    .main-wrapper {
      padding: 24px;
      margin-top: 20px;
    }
  }
</style>