---
// src/layouts/Layout.astro
interface Props {
  title?: string;
}

const { title = "Cloudflare Worker + JWT + CORS Test" } = Astro.props;
---

<!xhtml>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body {
    font-family: system-ui, -apple-system, sans-serif;
    max-width: 600px;
    margin: 40px auto;
    padding: 20px;
    color: #333;
  }
</style>