---
// src/pages/auth/reset-password.astro
import Layout from '../../layouts/Layout.astro';
import ResetPasswordForm from '../../components/ResetPasswordForm.astro';
---

<Layout title="Reset Password">
  <div class="portal-container">
    <div class="header-block">
      <h1>Reset Password</h1>
      <p class="subtitle">Enter your new secure password below.</p>
    </div>
    <ResetPasswordForm />
  </div>
</Layout>

<style>
  .portal-container {
    max-width: 800px;
    width: 100%;
    margin: 0 auto;
    padding: 15px;
    box-sizing: border-box;
  }
  .header-block {
    text-align: center;
    margin-top: 20px;
    padding: 0 10px;
  }
  .header-block h1 {
    font-size: 1.75rem;
    margin-bottom: 8px;
  }
  .subtitle {
    font-size: 0.95rem;
    color: #666;
    margin: 0;
  }
</style>