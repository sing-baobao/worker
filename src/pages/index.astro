---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import LoginPage from '../components/LoginPage.astro';
import RegisterForm from '../components/RegisterForm.astro';
import DashboardPanel from '../components/DashboardPanel.astro';
---

<Layout title="Portal">
  <div style="max-width: 800px; margin: 0 auto; padding: 20px;">
    
    <!-- LOGIN SECTION (Default static view) -->
    <div id="loginSection">
      <div style="text-align: center; margin-top: 40px;">
        <h1>Welcome</h1>
        <p style="color: #666;">Please sign in or register to continue.</p>
      </div>
      <LoginPage />
    </div>

    <!-- REGISTER SECTION (Hidden by default) -->
    <div id="registerSection" style="display: none;">
      <div style="text-align: center; margin-top: 40px;">
        <h1>Create Account</h1>
        <p style="color: #666;">Sign up for a new account.</p>
      </div>
      <RegisterForm />
    </div>

    <!-- DASHBOARD SECTION (Hidden by default) -->
    <div id="dashboardSection" style="display: none;">
      <DashboardPanel />
    </div>

  </div>
</Layout>

<script>
  import { API_URL } from '../config.js';

  // 1. Capture query parameters from redirects (Verification / OAuth)
  const urlParams = new URLSearchParams(window.location.search);
  const tokenParam = urlParams.get("token");
  const emailParam = urlParams.get("email");
  const actionParam = urlParams.get("action");

  // Handle Email Verification Action
  if (actionParam === "verify" && tokenParam && emailParam) {
    window.history.replaceState({}, document.title, window.location.pathname);

    fetch(`${API_URL}/api/auth/verify?token=${tokenParam}&email=${encodeURIComponent(emailParam)}`)
      .then(async (res) => {
        const data = await res.json();
        if (res.ok && data.token) {
          // Store token and reload so the session starts immediately
          localStorage.setItem("jwt", data.token);
          window.location.href = "/";
        } else {
          alert("Verification failed: " + (data.error || "Invalid link."));
        }
      })
      .catch((err) => {
        alert("Verification network error: " + err.message);
      });
  } 
  // Handle Standard OAuth Token Capture
  else if (tokenParam && !actionParam) {
    localStorage.setItem("jwt", tokenParam);
    window.history.replaceState({}, document.title, window.location.pathname);
  }

  // 2. Toggle view based on token existence
  const loginSection = document.getElementById("loginSection");
  const registerSection = document.getElementById("registerSection");
  const dashboardSection = document.getElementById("dashboardSection");
  const token = localStorage.getItem("jwt");

  if (token) {
    if (loginSection) loginSection.style.display = "none";
    if (registerSection) registerSection.style.display = "none";
    if (dashboardSection) dashboardSection.style.display = "block";
  } else {
    if (loginSection) loginSection.style.display = "block";
    if (registerSection) registerSection.style.display = "none";
    if (dashboardSection) dashboardSection.style.display = "none";
  }
</script>